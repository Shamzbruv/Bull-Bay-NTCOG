# Copy to .env for local development. On Railway, set these same three keys
# under Project → Variables instead of committing a .env file.

# Supabase project URL (Settings → API in the Supabase dashboard)
SUPABASE_URL=

# Supabase service_role key — server-side only, never expose to the browser
# (Settings → API → Project API keys → service_role, "legacy" JWT style key)
SUPABASE_SERVICE_KEY=

# Random string used to sign admin login session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
