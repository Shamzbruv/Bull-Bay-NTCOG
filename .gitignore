# ── Node ──────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Secrets (local dev only — set the same keys in Railway → Variables) ──
.env
.env.*
!.env.example

# ── Runtime state (auto-generated, not for git) ──
runtime.json

# ── macOS ─────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Editors ───────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Media (large, swappable — lives in Supabase Storage, not git) ──
# The background video/image and background music are now managed through
# the admin Media Library and stored in Supabase Storage, so the working
# copies below are just local scratch space and must never be committed.
public/video/
public/audio/
public/media/*.mp4
!public/media/Go in Peace.mp3
